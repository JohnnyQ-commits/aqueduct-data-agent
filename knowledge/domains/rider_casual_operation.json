{
    "domain_id": "rider_casual_operation",
    "name": "同城-骑手散单运营",
    "version": "1.0.0",
    "description": "同城骑手散单承接体量分析领域，用于骑手分层运营策略和收件权限管控",
    "metadata": {
        "owner": "Data Team",
        "update_frequency": "Ad-hoc (一次性4月数据)",
        "business_owner": "同城-骑手运营处"
    },

    "entities": {
        "Rider": {
            "primary_key": "emp_code",
            "description": "同城骑手实体，代表参与同城配送的收派员",
            "attributes": [
                { "name": "emp_code", "type": "string", "description": "骑手工号（业务主键）", "constraints": ["NOT NULL", "UNIQUE"] },
                { "name": "emp_name", "type": "string", "description": "骑手姓名", "constraints": ["NOT NULL"] },
                { "name": "area_code", "type": "string", "description": "所属地区编码" },
                { "name": "area_name", "type": "string", "description": "所属地区名称" },
                { "name": "rider_level", "type": "integer", "description": "骑手分级标签", "range": [1, 4], "enum_map": {"1": "见习", "2": "初级", "3": "中级", "4": "高级"} }
            ],
            "source": "dw_demo.dm_emp_rating_info_mi"
        },
        "Department": {
            "primary_key": "login_id",
            "description": "骑手网点归属关系，记录骑手与组织网点的映射",
            "attributes": [
                { "name": "login_id", "type": "string", "description": "收派员工号" },
                { "name": "org_dept_code", "type": "string", "description": "组织网点编码" },
                { "name": "job_status", "type": "integer", "description": "在职状态", "enum_map": {"0": "非在职", "1": "在职"} },
                { "name": "is_deleted", "type": "integer", "description": "删除标记", "enum_map": {"0": "正常", "1": "已删除"} },
                { "name": "update_time", "type": "string", "description": "记录更新时间戳" }
            ],
            "source": "dw_demo.dim_rider_org_info"
        },
        "AOIAssignment": {
            "primary_key": "id",
            "description": "骑手AOI服务区域配置，记录骑手常驻的配送区域",
            "attributes": [
                { "name": "emp_code", "type": "string", "description": "常驻收派员工号" },
                { "name": "aoi_area_id", "type": "string", "description": "AOI区域编码" },
                { "name": "status", "type": "tinyint", "description": "配置状态", "enum_map": {"1": "生效", "2": "废弃"} }
            ],
            "source": "dw_demo.dwd_area_group_info_partitioned"
        },
        "Waybill": {
            "primary_key": "waybill_no",
            "description": "运单实体，收件或派件的完整运单信息",
            "subclasses": ["PickupWaybill", "DeliverWaybill"],
            "attributes": [
                { "name": "waybill_no", "type": "string", "description": "运单号（业务主键）" },
                { "name": "emp_code", "type": "string", "description": "关联骑手工号" },
                { "name": "dept_code", "type": "string", "description": "关联网点编码" },
                { "name": "area_code", "type": "string", "description": "所属地区编码" },
                { "name": "freight_monthly_acct_code", "type": "string", "description": "运费月结账号" },
                { "name": "layer_name", "type": "string", "description": "客户分层名称，NULL表示无分层标签" },
                { "name": "inc_day", "type": "string", "description": "数据分区日期" }
            ],
            "source": "dw_demo.dwd_pickup_order_dtl_di | dw_demo.dwd_deliver_order_dtl_di"
        },
        "MonthlyCustomer": {
            "primary_key": "customer_code",
            "description": "月结客户实体，记录月结客群的标签分层",
            "attributes": [
                { "name": "customer_code", "type": "string", "description": "月结卡号（业务主键）" },
                { "name": "cust_tier_label", "type": "string", "description": "营销客群（3类）月结标签" },
                { "name": "billing_status", "type": "string", "description": "月结状态" }
            ],
            "source": "dm_crm.dm_customer_allcust_info_df"
        },
        "SandStat": {
            "primary_key": "emp_code",
            "description": "骑手散单统计聚合实体，为业务分析结果表",
            "attributes": [
                { "name": "emp_code", "type": "string", "description": "骑手工号" },
                { "name": "area_code", "type": "string", "description": "地区编码" },
                { "name": "area_name", "type": "string", "description": "地区名称" },
                { "name": "org_dept_code", "type": "string", "description": "所属网点编码" },
                { "name": "service_area", "type": "string", "description": "所属服务区域（AOI区域编码逗号拼接）" },
                { "name": "emp_name", "type": "string", "description": "骑手姓名" },
                { "name": "pure_casual_cnt", "type": "bigint", "description": "纯散件总数（4月收派件合计）", "constraints": [">= 0"] },
                { "name": "monthly_casual_cnt", "type": "bigint", "description": "月结散件总数（4月收派件合计）", "constraints": [">= 0"] },
                { "name": "inc_day", "type": "string", "description": "数据分区日期" }
            ],
            "source": "tmp_dw_demo.dm_ads_rider_casual_stat_202604_di"
        }
    },

    "hierarchy": {
        "Waybill": {
            "PickupWaybill": {
                "description": "收件运单，emp_code为揽收骑手",
                "discriminator": { "field": "direction", "value": "pickup" }
            },
            "DeliverWaybill": {
                "description": "派件运单，emp_code为派送骑手",
                "discriminator": { "field": "direction", "value": "deliver" }
            }
        },
        "SandType": {
            "PureSand": {
                "description": "纯散件：运单layer_name为空，无任何客户分层标签",
                "rule": "layer_name IS NULL"
            },
            "MonthlyCasual": {
                "description": "月结散件：运单月结卡号匹配月结客户表且cust_tier_label在1.1~2.2范围",
                "rule": "freight_monthly_acct_code IN (SELECT customer_code FROM MonthlyCustomer WHERE cust_tier_label IN ('1.1','1.2','1.3','2.1','2.2'))"
            },
            "NonSand": {
                "description": "非散件：layer_name非空且不匹配月结客群标签",
                "rule": "layer_name IS NOT NULL AND 不匹配月结客群"
            }
        }
    },

    "relationships": [
        {
            "from": "Rider",
            "to": "Department",
            "cardinality": "1:1",
            "join_type": "LEFT JOIN",
            "condition": "Rider.emp_code = Department.login_id",
            "description": "骑手归属唯一网点（去重取最新记录）"
        },
        {
            "from": "Rider",
            "to": "AOIAssignment",
            "cardinality": "1:N",
            "join_type": "LEFT JOIN",
            "condition": "Rider.emp_code = AOIAssignment.emp_code",
            "description": "骑手可配置多个AOI服务区域"
        },
        {
            "from": "Rider",
            "to": "PickupWaybill",
            "cardinality": "1:N",
            "join_type": "LEFT JOIN",
            "condition": "Rider.emp_code = PickupWaybill.emp_code",
            "description": "骑手在4月可有多条收件运单"
        },
        {
            "from": "Rider",
            "to": "DeliverWaybill",
            "cardinality": "1:N",
            "join_type": "LEFT JOIN",
            "condition": "Rider.emp_code = DeliverWaybill.emp_code",
            "description": "骑手在4月可有多条派件运单"
        },
        {
            "from": "Waybill",
            "to": "MonthlyCustomer",
            "cardinality": "N:1",
            "join_type": "LEFT JOIN",
            "condition": "Waybill.freight_monthly_acct_code = MonthlyCustomer.customer_code",
            "description": "运单通过月结卡号关联月结客户标签"
        },
        {
            "from": "Rider",
            "to": "SandStat",
            "cardinality": "1:1",
            "join_type": "INNER JOIN",
            "condition": "Rider.emp_code = SandStat.emp_code",
            "description": "统计结果与骑手一一对应"
        }
    ],

    "metrics": {
        "pure_casual_cnt": {
            "name": "纯散件总数",
            "definition": "骑手在4月收派件中layer_name为空的运单总数",
            "expression": "COUNT(CASE WHEN layer_name IS NULL THEN 1 END)",
            "aggregation": "SUM(pure_casual_pickup, pure_casual_deliver)",
            "filter": "inc_day BETWEEN '20260401' AND '20260430'",
            "unit": "件"
        },
        "monthly_casual_cnt": {
            "name": "月结散件总数",
            "definition": "骑手在4月收派件中月结卡号匹配月结客户表且月结标签在1.1~2.2的运单总数",
            "expression": "COUNT(CASE WHEN monthly_customer.customer_code IS NOT NULL THEN 1 END)",
            "aggregation": "SUM(monthly_casual_pickup, monthly_casual_deliver)",
            "filter": "inc_day BETWEEN '20260401' AND '20260430'",
            "unit": "件"
        },
        "sand_ratio": {
            "name": "散单骑手占比",
            "definition": "有散单数据的骑手数 / 骑手基表总数",
            "expression": "COUNT(CASE WHEN pure_casual_cnt + monthly_casual_cnt > 0 THEN 1 END) * 100.0 / COUNT(DISTINCT emp_code)",
            "unit": "%",
            "risk_threshold": "低于10%需人工复核"
        }
    },

    "computation_chains": {
        "total_casual_stat": {
            "definition": "骑手散单总量计算链路",
            "steps": [
                { "metric": "pure_casual_pickup", "operation": "COUNT", "description": "收件纯散件计数" },
                { "metric": "pure_casual_deliver", "operation": "COUNT", "description": "派件纯散件计数" },
                { "metric": "pure_casual_cnt", "operation": "ADD", "inputs": ["pure_casual_pickup", "pure_casual_deliver"], "description": "纯散件合计" },
                { "metric": "monthly_casual_pickup", "operation": "COUNT", "description": "收件月结散件计数" },
                { "metric": "monthly_casual_deliver", "operation": "COUNT", "description": "派件月结散件计数" },
                { "metric": "monthly_casual_cnt", "operation": "ADD", "inputs": ["monthly_casual_pickup", "monthly_casual_deliver"], "description": "月结散件合计" }
            ],
            "output": "SandStat"
        }
    },

    "business_rules": {
        "纯散件定义": "运单layer_name为NULL，表示下单手机号或月结卡号在销售系统中无任何客户分层标签",
        "月结散件定义": "运单freight_monthly_acct_code匹配月结客户表，且月结客户cust_tier_label在('1.1','1.2','1.3','2.1','2.2')范围内",
        "网点映射规则": "骑手网点通过dim_rider_org_id取login_id匹配emp_code，过滤在职且未删除，按update_time降序取最新一条",
        "服务区域聚合规则": "骑手AOI区域按emp_code分组，collect_set去重后concat_ws逗号拼接，仅取status=1生效配置",
        "收件权限约束": "仅高级骑手(rider_level=4)可接收全部类型散单，中级及以下不得收取纯散和月结散类型的下沉单"
    },

    "axioms": [
        {
            "id": "AX-001",
            "statement": "每个运单必然关联且仅关联一个骑手",
            "formal": "∀w ∈ Waybill, ∃!k ∈ Rider: w.emp_code = k.emp_code"
        },
        {
            "id": "AX-002",
            "statement": "骑手在同一分区中只属于一个网点",
            "formal": "∀k ∈ Rider, ∀d1,d2 ∈ Department: (k.emp_code=d1.login_id ∧ k.emp_code=d2.login_id) → d1.org_dept_code = d2.org_dept_code"
        },
        {
            "id": "AX-003",
            "statement": "散单分类互斥：一条运单只能是纯散、月结散、非散中的一种",
            "formal": "∀w ∈ Waybill: PureSand(w) XOR MonthlyCasual(w) XOR NonSand(w)"
        },
        {
            "id": "AX-004",
            "statement": "统计结果中的散单计数非负",
            "formal": "∀s ∈ SandStat: s.pure_casual_cnt ≥ 0 ∧ s.monthly_casual_cnt ≥ 0"
        }
    ],

    "filter_rules": {
        "monthly_customer_label": {
            "description": "月结客户标签有效值枚举",
            "values": ["1.1", "1.2", "1.3", "2.1", "2.2"]
        },
        "rider_period": {
            "description": "骑手基表固定取202604月度分区",
            "partition": "inc_day='202604'"
        },
        "waybill_period": {
            "description": "运单取4月全量（0401~0430）",
            "partition": "inc_day BETWEEN '20260401' AND '20260430'"
        },
        "courier_dept": {
            "description": "骑手维度表取T-1分区，在职且未删除",
            "partition": "inc_day='$[time(yyyyMMdd,-1d)]'",
            "conditions": ["job_status=1", "is_deleted=0"],
            "dedup": "row_number() over(partition by login_id order by update_time desc) = 1"
        },
        "aoi_config": {
            "description": "AOI分组取T-1分区生效配置",
            "partition": "inc_day='$[time(yyyyMMdd,-1d)]'",
            "conditions": ["status=1"]
        }
    }
}
